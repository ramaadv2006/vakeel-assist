# ========================================================
# VAKEEL ASSIST ENVIRONMENT CONFIGURATION EXAMPLE
# ========================================================

# Flask Application Settings
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your_flask_secret_key_here
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000,http://127.0.0.1:5000

# PostgreSQL Database (Supabase / RDS)
DATABASE_URL=postgresql://user:password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Auth Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Razorpay Standard Checkout Configuration (Web Payments)
# For local testing, use Razorpay Test Key ID and Secret
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# AI Services Configuration (Google Gemini / Groq)
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.0-flash
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# eCourts Live Portal API Gateway Configuration
ECOURTS_PROVIDER=live_portal
ECOURTS_API_URL=https://api.sandbox.co.in
ECOURTS_API_KEY=
ECOURTS_API_SECRET=
ECOURTS_PROVIDER_TYPE=sandbox

# Communication Channels (Optional Hearing Reminders)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
